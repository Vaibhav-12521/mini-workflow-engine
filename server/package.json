{
  "name": "@mwe/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/db/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=../.env src/db/cli.ts seed",
    "reset": "tsx --env-file-if-exists=../.env src/db/cli.ts reset",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@mwe/shared": "1.0.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
